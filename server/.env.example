PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kaushalsetu
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# No API keys needed: translation uses Google's unofficial gtx endpoint, speech uses the browser.
# Bhashini (optional). Empty = the browser's speech is used. When the key arrives, add server/src/bhashini.js (see README, "Bhashini") and set:
BHASHINI_API_KEY=
# Hiring fee (routes/hires.js). Fee = HIRE_FEE_PCT % of one month's pay, never below HIRE_FEE_MIN rupees.
# A Community Partner who registered the hired worker receives PARTNER_SHARE_PCT % of that fee.
HIRE_FEE_PCT=10
HIRE_FEE_MIN=200
PARTNER_SHARE_PCT=30
